# ──────────────────────────────────────────────
# 로얄앤컴퍼니 MCP 서버 환경변수 템플릿
# 이 파일을 복사해 .env 를 만들고 실제 값을 채우세요:
#   cp .env.example .env
# ──────────────────────────────────────────────

# MCP 서버 설정
MCP_SERVER_NAME=royal-mcp

# ── MS365 Graph API (Delegated / Device Code Flow) ──
# Azure Portal → Azure Active Directory → 앱 등록 → RoyalAI-MCP-Server
#
# [Azure AD 앱 설정 변경 필요]
#   1. "인증" → "퍼블릭 클라이언트 흐름 허용" = 예
#   2. "API 사용 권한" → Application 권한 제거 → Delegated 권한 추가
#   3. CLIENT_SECRET 불필요 (퍼블릭 클라이언트)
#
# [필요 Delegated 권한]
#   User.Read, User.Read.All, OrgContact.Read.All,
#   Mail.ReadWrite, Mail.Send, Calendars.ReadWrite,
#   ChannelMessage.Send, Chat.ReadWrite, Team.ReadBasic.All,
#   Sites.ReadWrite.All, Files.ReadWrite.All
#
TENANT_ID=your_tenant_id_here
CLIENT_ID=your_client_id_here
# CLIENT_SECRET 은 Delegated 인증에서 불필요 (퍼블릭 클라이언트)
# MS365_USER_EMAIL 은 서버 시작 시 Device Code 로그인한 계정이 자동 사용됨

# ── 자동 로그인 (선택) ──────────────────────────────────────────
# true : 서버 시작 시 캐시된 토큰으로 자동 인증 (기본값)
# false: 캐시 무시 — 매번 ms365_login 도구 호출 필요 (공용 PC·테스트용)
MS365_AUTO_AUTH=true

# 토큰 캐시 파일 경로 (미설정 시 ~/.royal-mcp/token_cache.bin)
# MS365_TOKEN_CACHE_PATH=
